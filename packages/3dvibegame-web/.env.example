# Default: server-side Gemini key (no API key required from players).
# Set to browser-gemini to use a player-supplied BYOK key instead.
VITE_AI_CLIENT_MODE=http-worker

# URL of the ai-worker server (required for http-worker mode).
VITE_AI_WORKER_URL=http://localhost:8787

# Optional: raise the client request timeout to match the server's author timeout (~60s).
# VITE_AI_WORKER_TIMEOUT_MS=60000

# Optional: use a player-supplied BYOK Gemini key (dev/fallback only).
# Only active when VITE_AI_CLIENT_MODE=browser-gemini.
# VITE_BROWSER_GEMINI_MODEL=gemini-2.5-flash

# Optional: connect to SpacetimeDB backend for multiplayer
# VITE_SPACETIMEDB_URI=http://localhost:3000
# VITE_SPACETIMEDB_DATABASE=3dvibegame
