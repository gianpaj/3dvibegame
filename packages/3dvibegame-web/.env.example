VITE_AI_CLIENT_MODE=browser-gemini

# Optional: AI worker that compiles the Gemini plan into geometry.
# When set, the browser calls Gemini for the plan (key stays in the browser) and
# POSTs that plan to the worker's /compile endpoint. When unset, the plan is
# compiled locally in the browser.
# VITE_AI_WORKER_URL=http://localhost:8787

# Optional: override the Gemini model / request timeout
# VITE_BROWSER_GEMINI_MODEL=gemini-2.5-flash
# VITE_AI_WORKER_TIMEOUT_MS=45000

# Optional: connect to SpacetimeDB backend for multiplayer
# VITE_SPACETIMEDB_URI=http://localhost:3000
# VITE_SPACETIMEDB_DATABASE=3dvibegame
