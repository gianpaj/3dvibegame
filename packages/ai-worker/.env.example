# Server-side Gemini API key (required for the /author endpoint).
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Optional: override the Gemini model used for generation.
# AI_WORKER_MODEL=gemini-2.5-flash

# Optional: daily spend cap in USD. Requests are rejected with 429 once exceeded.
# AI_WORKER_DAILY_BUDGET_USD=1.00

# Optional: per-IP rate limit (requests per minute). Excess requests get a 429.
# AI_WORKER_RATE_LIMIT_PER_MIN=10

# Optional: host and port the server binds to.
# AI_WORKER_HOST=127.0.0.1
# AI_WORKER_PORT=8787

# Optional: request timeout in ms for /generate and /compile endpoints.
# AI_WORKER_TIMEOUT_MS=20000

# Optional: CORS allowed origin. Defaults to * (all origins).
# AI_WORKER_ALLOWED_ORIGIN=https://3dvibegame.com

# Optional: set to 1 to skip Gemini calls and return a static plan (dev/testing).
# AI_WORKER_FAKE=0
